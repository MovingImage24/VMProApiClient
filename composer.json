{
    "name": "movingimage/vmpro-api-client",
    "description": "API client library for the VMPro public API",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Movingimage",
            "email": "developer@movingimage.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "doctrine/collections": "^1.6 || ^2.0",
        "doctrine/common": "^3.4",
        "firebase/php-jwt": "^6.0",
        "guzzlehttp/guzzle": "^7.0",
        "jms/serializer": "^3.12",
        "monolog/monolog": "^2.0 || ^3.0",
        "movingimage/video-manager-meta": "^3.2",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpspec/prophecy-phpunit": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "MovingImage\\Client\\VMPro\\": "lib"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MovingImage\\": "tests/MovingImage/",
            "MovingImage\\VMPro\\TestUtil\\": "tests/MovingImage/Util"
        }
    },
    "scripts": {
        "test": "php ./vendor/bin/phpunit",
        "fire": "php your-script.php",
        "cool": "php -v"
    }
}
